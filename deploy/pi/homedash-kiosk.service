# Console-only images (Raspberry Pi OS Lite, Ubuntu Server): HomeDash starts
# its own compositor on tty1. On a desktop image use homedash-kiosk.user.service
# instead - this unit would fight GDM for the seat and restart forever.
[Unit]
Description=HomeDash wall panel (labwc + Chromium kiosk)
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
Type=simple
User=@KIOSK_USER@
PAMName=login
TTYPath=/dev/tty1
# Hand the compositor a real tty. Without this labwc cannot take the seat and
# exits immediately with a permissions error that reads like a driver problem.
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

Environment=XDG_RUNTIME_DIR=/run/user/@KIOSK_UID@
Environment=XDG_SESSION_TYPE=wayland
Environment=HOME=/home/@KIOSK_USER@

# labwc runs the kiosk script as its startup command, so the browser's
# lifetime is bounded by the compositor's and there is no ordering race
# between the two.
ExecStart=/usr/bin/labwc -s /usr/local/bin/homedash-kiosk-start

Restart=always
RestartSec=5

# multi-user.target, not graphical.target: setup.sh sets the default target to
# multi-user on this path, so a unit wanted by graphical.target would never be
# reached and the panel would simply not come back after a reboot.
[Install]
WantedBy=multi-user.target
