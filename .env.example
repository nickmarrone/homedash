# Copy to .env and fill in before running `docker compose up`.

# IANA timezone the wall panel displays times in, e.g. America/New_York
HOMEDASH_HOME_TIMEZONE=UTC

# Calendars to show, as a single-line JSON list of {"name", "url"} objects.
# The URL is the secret iCal address from Google/Apple/Fastmail. Each calendar
# is automatically assigned its own color, in the order listed here.
# Read-only in Phase 1 - CalDAV write support lands in Phase 2.
# Must be valid JSON. Use [] to mean "no calendars" - an EMPTY value is a parse
# error and the backend refuses to start.
HOMEDASH_ICS_CALENDARS=[{"name": "Family", "url": "https://example.com/family.ics"}, {"name": "Nick", "url": "https://example.com/nick.ics"}]

# Home coordinates, used for the Open-Meteo weather/air-quality calls.
HOMEDASH_WEATHER_LATITUDE=0
HOMEDASH_WEATHER_LONGITUDE=0

# Temperature unit for the weather panel: fahrenheit or celsius.
HOMEDASH_WEATHER_TEMPERATURE_UNIT=fahrenheit
