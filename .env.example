# Copy to .env and fill in before running `docker compose up`.

# IANA timezone the wall panel displays times in, e.g. America/New_York
HOMEDASH_HOME_TIMEZONE=UTC

# Calendars to show, as a single-line JSON list. Each entry has a "name", a
# "kind", and whatever that kind needs. Each calendar is automatically assigned
# its own color, in the order listed here.
#
#   kind "ics"     (default)  needs "url"    - a secret iCal address
#   kind "caldav"             needs "url" and "credentials"
#   kind "google"             needs "calendar_id" and "credentials"
#
# The calendar is read-only whichever kind you use: HomeDash never writes back.
# Edit on your phone and the change syncs down.
#
# How fast a change reaches the panel depends entirely on the kind. An ICS feed
# is regenerated by the provider on its own schedule - often hours - so polling
# it faster achieves nothing. CalDAV and Google report changes as they happen
# and are polled every minute. Run `uv run homedash-inspect-calendars` to see
# which of your calendars can use a faster kind and what each one needs.
#
# Must be valid JSON on a SINGLE line: no trailing backslashes to wrap it across
# lines, and no backslashes inside the strings. Leave blank or use [] for
# "no calendars". A malformed value fails at startup with the offending
# character pointed out.
HOMEDASH_CALENDARS=[{"name": "Family", "url": "https://example.com/family.ics"}, {"name": "Nick", "kind": "caldav", "url": "https://caldav.fastmail.com/dav/calendars/user/nick/personal", "credentials": "fastmail"}]

# Secrets for the calendars above, keyed by the name each one's "credentials"
# field refers to. Kept separate from the calendar list so that list stays safe
# to paste into a bug report. Single-line JSON, same rules as above.
#
#   caldav: {"username": "...", "password": "..."}   an app-specific password
#   google: {"client_id": "...", "client_secret": "...", "refresh_token": "..."}
#           run `uv run homedash-google-auth` to obtain the refresh token
HOMEDASH_CALENDAR_CREDENTIALS={"fastmail": {"username": "nick@fastmail.com", "password": "app-password-here"}}

# How often each kind is polled, in minutes. The ICS interval is a floor set by
# the provider's own caching, not by us - lowering it will not make ICS faster.
HOMEDASH_ICS_POLL_INTERVAL_MINUTES=15
HOMEDASH_FAST_POLL_INTERVAL_MINUTES=1

# How often every calendar is fully re-fetched and re-expanded regardless of
# what its change detection reports. This rolls the materialization window
# forward, and bounds how long an event deleted at the source can survive on
# the panel if that calendar never reports the deletion.
HOMEDASH_FULL_RESYNC_INTERVAL_MINUTES=60

# First column of the week in the week and month views: sunday or monday.
HOMEDASH_WEEK_STARTS_ON=sunday

# Home coordinates, used for the Open-Meteo weather/air-quality calls.
HOMEDASH_WEATHER_LATITUDE=0
HOMEDASH_WEATHER_LONGITUDE=0

# Bright comets, from the Minor Planet Center's orbital element file. This is
# the only thing in HomeDash that reaches the internet on a schedule; set it to
# false to keep the panel entirely self-contained. Elements are cached on disk
# beside the database, so a failed refresh falls back to the last good copy.
#
# The magnitude limit is deliberately conservative: comet brightness forecasts
# routinely miss by magnitudes, so a generous limit fills the strip with comets
# nobody can actually find. 6.0 is roughly the naked-eye limit.
HOMEDASH_COMETS_ENABLED=true
HOMEDASH_COMET_REFRESH_HOURS=24
HOMEDASH_COMET_MAGNITUDE_LIMIT=6.0

# Temperature unit for the weather panel: fahrenheit or celsius.
HOMEDASH_WEATHER_TEMPERATURE_UNIT=fahrenheit

# When the wall panel's screen is lit, as single-line JSON. Times are wall-clock
# in HOMEDASH_HOME_TIMEZONE - the Pi's own clock is never consulted. The Pi's
# screen agent polls this and applies it; see deploy/pi/README.md.
#
# `weekend` is optional and overrides Saturday and Sunday. An "on" later than
# "off" is a window crossing midnight, not an error: {"on": "22:00", "off":
# "06:00"} lights the screen overnight. Equal times mean "always on".
HOMEDASH_SCREEN_SCHEDULE={"on": "06:30", "off": "21:30", "weekend": {"on": "08:00", "off": "22:00"}}

# Name for the panel, shown nowhere yet but stored on its devices row.
HOMEDASH_DEVICE_NAME=panel
